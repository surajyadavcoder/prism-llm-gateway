# Copy this file to .env and fill in your real values. Never commit .env.

# Admin API key -- required for all /admin/* endpoints (provider health
# toggle, key inventory). If unset, a random key is generated at process
# startup and printed once to the logs -- set this explicitly for anything
# beyond local testing so the admin key is stable across restarts.
ADMIN_API_KEY=

# Set to "true" to route through real providers via OpenRouter instead of mocks.
PRISM_USE_REAL_PROVIDERS=false

# OpenRouter key (from Airtribe) -- used only when PRISM_USE_REAL_PROVIDERS=true
OPENROUTER_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Comma-free single origin or "*" -- CORS allow-origin for the API.
# Lock this to your actual frontend's origin in production.
PRISM_ALLOWED_ORIGINS=*
